@model Category

<div class="row">
    <div class="col-lg-12 grid-margin stretch-card">
        <div class="card">
            <div class="card-body">
                <h4 class="card-title">Category Detail Table</h4>
                <div class="table-responsive">
                    <a asp-controller="category" asp-action="index" class="btn btn-outline-info btn-fw">Go Back</a>
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>
                                    Name
                                </th>
                                <th>
                                    Products
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                                <tr>
                                    <td>
                                        <p>@Model.Name</p>
                                    </td>
                                    <td>
                                        <p>@Model.Products.Count</p>
                                    </td>
                                </tr>
                            
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>